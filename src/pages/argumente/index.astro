---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import { pfad } from '../../lib/pfad';
import { MARKE } from '../../lib/site';

const module = (await getCollection('argumente')).sort((a, b) =>
  a.data.modul.localeCompare(b.data.modul)
);
---
<Basis title={`Argumente | ${MARKE}`} beschreibung="Sechs Module zur Vermögensverteilung in Österreich, jeweils mit Quellen und Gegenargumenten.">
  <p class="etikett" slot="rand">Sechs Module</p>

  <h1>Argumente</h1>
  <p class="lead">Sechs Module. Jedes mit einer Grafik, den Quellen und den stärksten Gegenargumenten.</p>
  <ul class="karten">
    {module.map((m) => (
      <li>
        <a href={pfad(`/argumente/${m.id}/`)}>
          <span class="karten__marke" aria-hidden="true">{m.data.modul}</span>
          <strong><span class="sr-only">Modul {m.data.modul}: </span>{m.data.title}</strong>
          <span>{m.data.beschreibung}</span>
        </a>
      </li>
    ))}
  </ul>
</Basis>
